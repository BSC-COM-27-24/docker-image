# Docker Hub image to pull (used by docker-compose.hub.yml)
DOCKERHUB_USERNAME=your-dockerhub-username
PMS_API_TAG=main

# Required runtime secrets; replace these before starting the stack
DB_PASSWORD=replace-with-a-unique-database-password
JWT_SECRET=replace-with-a-long-random-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional email settings (email features stay disabled unless enabled)
RECOVERY_EMAIL_ENABLED=false
RECOVERY_EMAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
